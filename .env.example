# Copy to .env and fill in real values. NEVER commit the .env file.

# --- Service passwords (REQUIRED) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-strong-random-password
REDIS_PASSWORD=change-me-strong-random-password

# --- App secrets (REQUIRED in production) ---
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-64
COOKIE_SECRET=replace-with-openssl-rand-hex-64

# --- Misc ---
NODE_ENV=production
VITE_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
OPENAI_API_KEY=
