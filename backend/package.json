{
  "name": "algovision-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for AlgoVision AI - AI-powered DSA tutor",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node workers/dailyChallengeWorker.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__/integration",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint . --ext js",
    "lint:fix": "eslint . --ext js --fix",
    "seed:badges": "node scripts/seedBadges.js",
    "seed:daily": "node scripts/seedDailyChallenges.js",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "dsa",
    "leetcode",
    "ai",
    "visualization"
  ],
  "author": "AlgoVision AI Contributors",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
