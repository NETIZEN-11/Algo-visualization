# ----------------------------------------------------------------------
# AlgoVision AI — backend environment variables (example)
#
# Copy to .env, fill in real values. NEVER commit a real .env.
# ----------------------------------------------------------------------

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/algovision?authSource=admin
REDIS_URL=redis://:CHANGE_ME@redis:6379

# --- Security ---------------------------------------------------------
# Use `openssl rand -hex 64` to generate a strong secret.
JWT_SECRET=replace-me-with-a-strong-random-string-at-least-32-bytes
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
COOKIE_SECRET=replace-me-with-a-strong-random-string

# --- CORS -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI ---------------------------------------------------------------
# MOCK_AI=true is for dev only. In production, the server refuses to
# boot unless OPENAI_API_KEY is set and MOCK_AI is unset.
MOCK_AI=true
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.4
DAILY_AI_TOKEN_LIMIT=200000

# --- Email (optional in dev) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@algovision.ai
MAIL_VERIFY_URL=http://localhost:3000/verify-email
MAIL_RESET_URL=http://localhost:3000/reset-password

# --- OAuth (Google + GitHub) -----------------------------------------
# Create OAuth apps at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# The redirect URI for both must point at
#   <OAUTH_REDIRECT_BASE>/api/auth/oauth/<provider>/callback
# For local dev the base is the API origin (http://localhost:5000).
OAUTH_REDIRECT_BASE=http://localhost:5000
SPA_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
